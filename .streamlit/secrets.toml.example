# ===========================================================================
# secrets.toml — EXAMPLE TEMPLATE
# ===========================================================================
#
# Built for xAI, X, Grok and the ecosystem community win — keep secrets local-first.
#
# Streamlit reads secrets from `.streamlit/secrets.toml` (gitignored). This
# file is an EXAMPLE that documents which keys agents may need. Do NOT put
# real secrets in this file — copy it to `.streamlit/secrets.toml`, fill in
# the values, and the .gitignore at the repo root will keep it out of Git.
#
# To use:
#   1. Copy this file:
#         Copy-Item .streamlit\secrets.toml.example .streamlit\secrets.toml
#   2. Fill in the values you actually need (most agents need only 1-2).
#   3. Streamlit picks them up automatically as `st.secrets["KEY_NAME"]`.
#
# Reading from Python:
#   import streamlit as st
#   xai_key = st.secrets["XAI_API_KEY"]                  # flat
#   newsapi = st.secrets["api_keys"]["NEWSAPI_KEY"]      # nested table
#
# Local-first reminder: every key here is OPTIONAL. An agent that only uses
# Grok 4.3 needs only XAI_API_KEY. An agent with no public-API integration
# needs nothing here at all.
# ===========================================================================

# ---------------------------------------------------------------------------
# xAI / Grok 4.3 — the only key most agents need
# ---------------------------------------------------------------------------
XAI_API_KEY = "xai-your-api-key-here"

# ---------------------------------------------------------------------------
# X (Twitter) API — for x-native agents and X Money tools that touch X data
# ---------------------------------------------------------------------------
X_API_TOKEN = "your-x-bearer-token-here"
X_API_KEY = "your-x-api-key-here"
X_API_SECRET = "your-x-api-secret-here"

# ---------------------------------------------------------------------------
# Public APIs used by Phase 4 Super Agents (Living Narrative Fabric, etc.)
# Free tiers exist for all of these. Most are optional per-agent.
# ---------------------------------------------------------------------------
[api_keys]
NEWSAPI_KEY = "your-newsapi-key"            # https://newsapi.org — 100/day free
GNEWS_KEY = "your-gnews-key"                # https://gnews.io — 100/day free
DATA_GOV_KEY = "your-data-gov-key"          # https://api.data.gov — free + 1k/hr
COINGECKO_KEY = ""                          # https://coingecko.com — free tier needs no key

# Semantic Scholar requires no key for the free tier; keep this commented:
# SEMANTIC_SCHOLAR_KEY = ""

# ---------------------------------------------------------------------------
# Tracing + evaluation (optional; used by Phase 4 self-improvement loop)
# ---------------------------------------------------------------------------
[langfuse]
LANGFUSE_PUBLIC_KEY = "pk-lf-your-public-key"
LANGFUSE_SECRET_KEY = "sk-lf-your-secret-key"
LANGFUSE_HOST = "https://cloud.langfuse.com"

# ---------------------------------------------------------------------------
# Memory backends (optional; used by Super Agents that declare `memory:`)
# ---------------------------------------------------------------------------
[memory]
MEM0_API_KEY = ""                           # leave blank for self-hosted Mem0
QDRANT_URL = "http://localhost:6333"        # default local Qdrant
QDRANT_API_KEY = ""                         # blank for local

# ---------------------------------------------------------------------------
# Per-tool overrides (rarely needed)
# Tools may read their own subkeys, e.g. st.secrets["x_money_companion"]["DB_PATH"]
# ---------------------------------------------------------------------------
# [x_money_companion]
# DB_PATH = "C:\\Users\\YOU\\AppData\\Local\\grok-agent\\x-money-companion-dashboard\\data.db"

# Reminder: this file is for documenting available keys. Real secrets go in
# .streamlit/secrets.toml (gitignored). Built for xAI, X, Grok and the ecosystem community win.
