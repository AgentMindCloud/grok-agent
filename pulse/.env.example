# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real tokens.

# GitHub fine-grained Personal Access Token.
# Create at: https://github.com/settings/personal-access-tokens
# Minimum scopes (read-only): Actions, Contents, Issues, Metadata, Pull requests, Notifications, Starring.
GITHUB_TOKEN=

# Your GitHub username (login). Optional — server will resolve via /user if omitted.
GITHUB_USER=

# xAI API key. Get one at: https://console.x.ai
XAI_API_KEY=

# Optional: pin Grok to a specific model. Defaults to grok-4-latest.
# XAI_MODEL=grok-4-latest

# Optional: override the xAI API base URL (for testing / proxies).
# XAI_BASE_URL=https://api.x.ai/v1
